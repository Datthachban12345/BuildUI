# Provider: auto selects OpenRouter when its key is present; otherwise deterministic offline.
LLM_PROVIDER=auto
OPENROUTER_API_KEY=
# Example OpenRouter model IDs: openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-flash-1.5
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=45

# Future direct/native provider keys. Not used until their adapters are added.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Server
PORT=8000
HOST=0.0.0.0
